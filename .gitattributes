# 交付红线：所有文本文件一律 LF 入库并检出为 LF。
# 容器是 Linux，.sh / Dockerfile / my.cnf 若带 CRLF 会直接报 bad interpreter 或解析失败。
* text=auto eol=lf

*.sh      text eol=lf
*.bash    text eol=lf
Dockerfile text eol=lf
*.conf    text eol=lf
*.cnf     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sql     text eol=lf
*.py      text eol=lf
*.java    text eol=lf
*.js      text eol=lf
*.vue     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
