# ============================================================================
# smart-park 生产环境配置（客户唯一填写入口）
#
# 用法： cp .env.example .env  然后填写所有空值
# 铁律：
#   - .env 严禁提交 git（已在 .gitignore 排除）、严禁拷贝出生产机
#   - 文件权限：chmod 600 .env
#   - 修改任何项后需执行： docker compose --env-file .env up -d
#   - 所有密码/密钥请用下方 openssl 命令现场生成，不要复用、不要用弱口令
# ============================================================================

# -------- 应用版本（回滚开关：改这一行即可切版本）--------
APP_VERSION=1.0.0

# -------- 端口与网络 --------
# 对外访问端口（80 被占用时改，如 8081）
NGINX_PORT=80
# 容器内网网段。⚠ 部署前确认客户 LAN 未占用该段：ip -4 route | grep -E '^172\.28\.'
# 若冲突改为其他段（如 172.31.0.0/24），MySQL 账号授权 host 会自动联动
SP_NET_SUBNET=172.28.0.0/24

# -------- MySQL（三个账号分权，均需随机强口令）--------
# root：仅本机排查用（openssl rand -base64 24）
MYSQL_ROOT_PASSWORD=
# 业务库名（默认 smart_park，一般不改）
MYSQL_DATABASE=smart_park
# 应用运行时账号：仅 SELECT/INSERT/UPDATE/DELETE，无 DDL、无 DROP
MYSQL_APP_USER=smartpark_app
MYSQL_APP_PASSWORD=
# 迁移账号：仅 Flyway 发布期使用，含 DDL 权限
MYSQL_MIG_USER=smartpark_mig
MYSQL_MIG_PASSWORD=
# 备份账号：只读 + 锁表，仅允许容器内 socket 连接
MYSQL_BAK_USER=smartpark_bak
MYSQL_BAK_PASSWORD=

# -------- 应用安全（SMARTPARK_ 前缀 = 应用级配置）--------
# JWT 签名密钥，HS256 至少 32 字节： openssl rand -base64 48
SMARTPARK_JWT_SECRET=
# CORS 白名单：同域 Nginx 部署留空即可（空 = 不注册 CORS mapping）；
# 前后端分域名时填写，多个用逗号分隔，例：https://a.example.com,https://b.example.com
SMARTPARK_CORS_ORIGINS=
# 字段加密密钥（敏感字段加密）： openssl rand -base64 32
SMARTPARK_CRYPTO_KEY=
# 字段加密 HMAC 密钥（完整性校验）： openssl rand -base64 32
SMARTPARK_CRYPTO_HMAC_KEY=

# -------- 监控（可选）--------
# 默认 health（最小暴露）；客户选装 Prometheus 附加包时改为 health,metrics,prometheus
# 注意：仅放开暴露 ≠ 放行访问，还需后端 SecurityConfig 追加内网抓取源授权规则
ACTUATOR_EXPOSE=health

# -------- JVM（容器内存 1g 时保持默认即可）--------
JAVA_OPTS=

# -------- 备份（可选）--------
# 异机/离线备份目标，留空则只保留本机备份本。例：user@backup-host:/backup/smart-park/
RSYNC_TARGET=
