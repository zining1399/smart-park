# smart-park 生产 MySQL 服务端参数
# 挂载为 /etc/mysql/conf.d/smart-park.cnf（只读），改动后需重建 mysql 容器生效
#
# 注意：本文件由 data-engineer 方案提供，运维侧仅负责挂载与验证。
[mysqld]
# -------- 字符集：必须 utf8mb4（MySQL 的 utf8 是 3 字节残缺版，存不了 emoji）--------
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# -------- 时区：与 JDBC serverTimezone=Asia/Shanghai / JVM -Duser.timezone 四层一致 --------
default_time_zone    = +08:00

# -------- 持久性（双一配置，保证崩溃不丢已提交事务）--------
innodb_flush_log_at_trx_commit = 1
sync_binlog                    = 1

# -------- binlog（PITR 基础，必须开）--------
server_id                = 1
log_bin                  = /var/lib/mysql/mysql-bin
binlog_format            = ROW
binlog_row_image         = MINIMAL
binlog_expire_logs_seconds = 604800      # 7 天

# -------- 连接 --------
max_connections = 200                    # Hikari 20/实例 × N + 预留 < 200，实操上限 5 个实例
wait_timeout    = 28800                  # 应用侧 max-lifetime 必须小于此值

# -------- 慢查询（上线后调优依据）--------
slow_query_log      = ON
long_query_time     = 2
slow_query_log_file = /var/lib/mysql/slow.log

# -------- 表名大小写：Linux 默认 0，不要为迁移改它 --------
lower_case_table_names = 0

# -------- 禁用反向 DNS --------
# 账号授权用 IP 段（172.28.%），禁用反解可避免 DNS 不可靠时的偶发连接超时。
# 副作用：主机名形式的授权（@'app-host'）会失效，但 socket 连接与 @'localhost' 不受影响。
skip-name-resolve
