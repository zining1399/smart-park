{
  "name": "smart-park-e2e",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "智慧园区管理系统 E2E 冒烟测试（Playwright）",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=chromium",
    "test:compat": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2"
  }
}
