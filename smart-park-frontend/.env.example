# 环境变量模板：复制为 .env.development / .env.production 后按需修改
# 注意：仓库 .gitignore 忽略 .env.*，交付/部署时请在目标环境放置同名文件，
# 或直接依赖代码内兜底默认值（VITE_API_BASE 默认 /api，VITE_BASE 默认 /）。

# 接口基地址。开发走 Vite 代理；生产由 Nginx 同域反代 /api
VITE_API_BASE=/api

# dev server 的 /api 代理目标（仅开发环境生效）
VITE_PROXY_TARGET=http://localhost:8080

# 部署基础路径。根路径部署留空或 /；子路径部署填 /park/（会同时驱动 vite base 与 router base）
VITE_BASE=/

# 站点标题
VITE_APP_TITLE=智慧园区管理系统
